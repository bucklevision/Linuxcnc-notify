#!/bin/sh
set -e
install -d -m 755 /etc/linuxcnc-notify
install -d -m 700 /var/lib/linuxcnc-notify
if [ ! -e /etc/linuxcnc-notify/config.json ]; then
    LINUXCNC_NOTIFY_CONFIG=/etc/linuxcnc-notify/config.json /usr/bin/linuxcnc-notify show-config >/dev/null
fi
if [ ! -e /etc/linuxcnc-notify/notify.conf ]; then
    install -m 644 /usr/share/linuxcnc-notify/notify.conf /etc/linuxcnc-notify/notify.conf
fi
chmod 600 /etc/linuxcnc-notify/config.json
systemctl daemon-reload >/dev/null 2>&1 || true
if [ -e /etc/systemd/system/linuxcnc-notify.service.d/user.conf ]; then
    systemctl enable --now linuxcnc-notify.service >/dev/null 2>&1 || true
    systemctl restart linuxcnc-notify.service >/dev/null 2>&1 || true
else
    systemctl disable --now linuxcnc-notify.service >/dev/null 2>&1 || true
fi
echo "LinuxCNC Notify installed. Run: sudo linuxcnc-notify setup"
